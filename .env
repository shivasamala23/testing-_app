# ==========================================
# INSTAGRAM SCALE INFRASTRUCTURE ENVIRONMENT
# ==========================================

# Server Ports
PORT=4000
NODE_ENV=production

# PostgreSQL Database
POSTGRES_USER=instagram_admin
POSTGRES_PASSWORD=scale_super_secret_password
POSTGRES_DB=instagram_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://instagram_admin:scale_super_secret_password@postgres:5432/instagram_db

# Redis In-Memory Cache
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# Redpanda / Kafka Distributed Event Broker
KAFKA_BROKER=redpanda:9092
KAFKA_CLIENT_ID=instagram-ingestion-service
KAFKA_TOPIC_LIKES=post-likes
KAFKA_TOPIC_FANOUT=fanout-notifications

# MinIO (S3-Compatible Object Storage)
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_super_secret_password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_NAME=instagram-media
S3_ENDPOINT=http://minio:9000
